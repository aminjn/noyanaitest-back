  // (npm test). server.ts is included only for its global Express.Request
  // augmentation (req.user, req.doctor, ...).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["./**/*.ts", "../server.ts"],
  "exclude": []
}
